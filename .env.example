# Copy this file to .env and fill in real values before an EAS/production build.
# Never commit the real .env file — it's gitignored.
# All Expo-inlined vars must be prefixed EXPO_PUBLIC_ (see https://docs.expo.dev/guides/environment-variables/).

# RevenueCat — Project Settings > API Keys (per-platform public SDK key)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AdMob — real ad unit IDs (test IDs are hardcoded as the default fallback in adsService)
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS_UNIT_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID_UNIT_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS_UNIT_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID_UNIT_ID=

# PostHog
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry
EXPO_PUBLIC_SENTRY_DSN=

# Supabase (Friend Duel — fully optional feature)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
